{
  "name": "@autoprint/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "autoprint-agent": "src/index.js"
  },
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "package:win": "pkg . --targets node18-win-x64 --output dist/AutoPrint-Agent.exe"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "pdf-to-printer": "^5.1.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
