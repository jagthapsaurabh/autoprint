DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-super-secret-in-production"
PORT=4000
PUBLIC_BASE_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
NODE_ENV="production"

# Razorpay (test mode keys - get free ones at https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Payouts: how much of each ONLINE customer payment gets credited to a
# shop's in-app wallet. Cash-at-counter and no-payment jobs never touch the
# wallet at all — see apps/server/src/lib/payout.js.
#
# The platform's own cut, if any, taken from every online payment on top of
# the flat Rs 499/mo subscription. Default 0 (subscription-only revenue).
PLATFORM_COMMISSION_PERCENT=0
# Fallback gateway-fee percentage used only when the real per-payment fee
# can't be fetched from Razorpay (e.g. demo/manual-confirm mode). Razorpay's
# standard domestic rate is ~2% + 18% GST on the fee (~2.36% effective).
RAZORPAY_ASSUMED_FEE_PERCENT=2.36

# Housekeeping (defaults shown below, in milliseconds)
# How long uploaded/merged files are kept once a job is no longer active.
FILE_RETENTION_MS=86400000
# How long finished (printed/failed/cancelled) job rows are kept in the DB.
JOB_RECORD_RETENTION_MS=2592000000
